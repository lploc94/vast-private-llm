# Reference only: the app reads shell environment variables, not this file.
# Export values in your shell before starting the dashboard if needed.
VASTLLM_DATA_DIR=./data
# Optional: use an existing SSH private key instead of the app-managed key.
# VASTLLM_SSH_KEY_PATH=~/.ssh/id_ed25519

# Optional. You can paste a Vast key into the Deploy tab instead.
# VAST_API_KEY=PASTE_YOUR_VAST_API_KEY_HERE
